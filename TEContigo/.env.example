# ==========================================
# PostgreSQL
# ==========================================
TECONTIGO_CONNECTION_STRING=Host=host.docker.internal;Port=5432;Database=TEContigo;Username=postgres;Password=TU_PASSWORD_REAL

# ==========================================
# Email - Gmail SMTP
# ==========================================
Email__Host=smtp.gmail.com
Email__Port=587
Email__Username=
Email__Password=
Email__FromName=

# ==========================================
# JWT
# ==========================================
Jwt__Key=TU_CLAVE_JWT_SEGURA
Jwt__Issuer=TEContigo
Jwt__Audience=TEContigoApp
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7

# ==========================================
# AWS
# ==========================================
AWS__Region=us-east-1
AWS__BucketName=tecontigo-images
AWS__AccessKeyId=
AWS__SecretAccessKey=
AWS__SessionToken=